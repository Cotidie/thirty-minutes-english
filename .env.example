# 필수. 호스트에서 `claude setup-token`을 돌려 나온 값(1년짜리). 세션 생성과 코치 텍스트가 Claude 구독으로 돈다.
CLAUDE_CODE_OAUTH_TOKEN=
# 브라우저로 여는 포트. 이 머신의 127.0.0.1에만 열린다. 외부 공개는 앞단의 프록시나 터널이 맡는다.
FRONTEND_PORT=5173
# 운영자 계정. 처음 시작할 때 이 값으로 만들어지고, 그 전의 세션은 모두 이 계정 소유가 된다.
ADMIN_EMAIL=
# 운영자 비밀번호. 8자 이상. 운영자가 생긴 뒤에는 값을 바꾸고 다시 시작하면(docker compose up -d) 비밀번호가
# 바뀌고 운영자의 로그인이 모두 끊긴다. 비워 두면 지금 비밀번호를 유지한다.
ADMIN_PASSWORD=
# 로그인 쿠키는 HTTPS(와 localhost)로만 오간다. 그 밖의 주소에서 평문 HTTP로 쓸 때만 false로 둔다.
# COOKIE_SECURE=false
# 이 머신의 계정 uid가 1000이 아니면 적는다(`id -u`). backend/data에 쓰는 파일의 소유자가 된다.
# UID=1000

# 나머지 설정(API 키, 모델)은 앱의 ⚙ 설정 모달에서 넣는 게 기본이다. 저장한 값은 DB에 남는다.
# 여기에 적어도 된다: 이름과 기본값은 backend/app/config/settings.py의 SPECS.
# 예: GEMINI_API_KEY=AIza...
