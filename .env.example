# 비워 두면 호스트의 claude 로그인(~/.claude/.credentials.json)을 컨테이너가 복사해 쓴다.
# 호스트 로그인과 분리하고 싶을 때만 `claude setup-token` 결과를 넣는다.
CLAUDE_CODE_OAUTH_TOKEN=
# opus | sonnet
CLAUDE_MODEL=opus
# reasoning effort: low | medium | high | xhigh | max
CLAUDE_EFFORT=xhigh
# 생성 전에 호출할 스킬. 쉼표로 구분. 예: stop-slop,cotidie:write-like-me
CLAUDE_SKILLS=
# 브라우저로 여는 포트
FRONTEND_PORT=5173
# Voice 모델용 OpenAI
OPEN_AI_KEY=# Read aloud 코치(GPT-Live). 비우면 Article 탭의 Read aloud 버튼이 503을 돌려준다
OPENAI_API_KEY=
