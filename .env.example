# 비워 두면 호스트의 claude 로그인(~/.claude/.credentials.json)을 컨테이너가 복사해 쓴다.
# 호스트 로그인과 분리하고 싶을 때만 `claude setup-token` 결과를 넣는다.
CLAUDE_CODE_OAUTH_TOKEN=
# opus | sonnet
CLAUDE_MODEL=opus
# reasoning effort: low | medium | high | xhigh | max
CLAUDE_EFFORT=xhigh
# 생성 전에 호출할 스킬. 쉼표로 구분. 예: stop-slop,cotidie:write-like-me
CLAUDE_SKILLS=
# 브라우저로 여는 포트
FRONTEND_PORT=5173
# 아래 값은 초기값이다. 앱의 ⚙ 설정 모달에서 저장한 값이 DB에 남아 그 뒤로는 우선한다(재시작 불필요).
# 음성 코치(Read aloud, Your turn, Ask) provider: openai | gemini
VOICE_PROVIDER=openai
# 비우면 provider 기본값: gpt-live-1 / gemini-3.8-live-extended-thinking
VOICE_MODEL=
# gemini-3.8-live-extended-thinking 전용 thinking 수준: low | medium | high
VOICE_THINKING=low
# Gemini 음성 이름 (OpenAI는 각 코치의 session.json 값을 쓴다)
VOICE_NAME=Kore
# OpenAI: GPT-Live 코치와 Summary 탭 텍스트 추출. 키가 없으면 해당 기능이 503을 돌려준다
OPENAI_API_KEY=
# Gemini Live 코치. provider가 gemini일 때만 쓴다
GEMINI_API_KEY=
# Read aloud 판정기: Azure Speech 리소스의 키와 리전. 키가 없으면 Read aloud 버튼이 503
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
# 단어 AccuracyScore가 이 값 아래면 발음 교정 (0~100)
ASSESS_WORD_SCORE=60
# 단어 앞 UnexpectedBreak confidence가 이 값 위면 끊어읽기 교정 (0~1)
ASSESS_BREAK_CONFIDENCE=0.75
# Summary 탭에서 Ask transcript를 카드로 정리하는 텍스트 모델
SUMMARY_MODEL=gpt-5.6-luna
# 하루 한 번 뉴스에서 주제를 뽑는 모델. 세션 생성보다 가볍게 돌린다
TOPICS_MODEL=sonnet
TOPICS_EFFORT=medium
# Vocabulary 단어마다 그림 한 장. 그리는 MCP: openrouter | comfy | off. 고른 쪽의 API 키가 있어야 한다
IMAGE_PROVIDER=openrouter
OPENROUTER_API_KEY=
COMFY_API_KEY=
# 이미지 모델. 비우면 provider 기본값(Nano Banana Pro). 목록은 설정 모달 메뉴에
IMAGE_MODEL=
# 그림 스타일: photo | cinematic | storybook | comic | sketch | flat
IMAGE_STYLE=photo
