#!/usr/bin/env bash
# Brings the server up to main and rebuilds the stack. The server's own .env holds its secrets and port.
#
#   scripts/deploy user@host [dir]   dir is relative to the server's home
set -euo pipefail

target=${1:?usage: scripts/deploy user@host [dir]}
dir=${2:-repositories/thirty-minutes-english}

ssh "$target" "cd '$dir' && git pull --ff-only && docker compose up -d --build"

# Through nginx, so a pass means both containers answer. The backend takes a few seconds after a rebuild.
ssh "$target" "cd '$dir' && for attempt in \$(seq 30); do
  docker compose exec -T frontend wget -qO /dev/null http://127.0.0.1/api/sessions && { echo \"smoke ok: \$(git describe --tags)\"; exit 0; }
  sleep 2
done
echo 'smoke failed: /api/sessions never answered; see docker compose logs backend' >&2
exit 1"
